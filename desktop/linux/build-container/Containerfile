# The Linux build machine, as a container: Ubuntu 24.04 like the GitHub runner in
# .github/workflows/dev-build.yml, so a tarball built on a newer-glibc desktop still
# keeps the glibc 2.38 promise (spec.md). scripts/build-linux-local.sh builds and runs it.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
# The workflow's bundle tools and xcb helpers, plus the runtime libraries the runner
# image already has and Qt loads while Nuitka scans it (glib, zstd and the rest).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git build-essential pkg-config \
      patchelf binutils ccache libxcb-cursor0 libxcb-icccm4 libxcb-image0 \
      libxcb-keysyms1 libxcb-render-util0 libxcb-util1 \
      libxkbcommon0 libxkbcommon-x11-0 xvfb xauth \
      libegl1 libgl1 libopengl0 libglx0 libgles2 libgl1-mesa-dri libfontconfig1 libdbus-1-3 \
      libglib2.0-0t64 libfreetype6 libx11-6 libx11-xcb1 libxext6 libxrender1 libxcb1 libxcb-randr0 \
      libxcb-shape0 libxcb-xfixes0 libxcb-xkb1 libxcb-shm0 libxcb-sync1 libxcb-glx0 libgssapi-krb5-2 \
      libnss3 libasound2t64 libpulse0 libxi6 libsm6 libice6 libzstd1 libbrotli1 libpng16-16t64 \
      libharfbuzz0b libexpat1 zlib1g liblzma5 libbz2-1.0 \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/usr/lib/ccache:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
# The same CPython build actions/setup-python installs on the runner. It matters: its _zstd
# module links the system libzstd, which is how the bundle gets the libzstd Qt also needs.
# Keep the version in step with what the workflow's "3.14" resolves to.
ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
RUN mkdir -p /tmp/py && cd /tmp/py \
    && curl -sSfL https://github.com/actions/python-versions/releases/download/3.14.10-40336797752/python-3.14.10-linux-24.04-x64.tar.gz | tar -xz \
    && bash ./setup.sh && cd / && rm -rf /tmp/py
ENV PATH=/opt/hostedtoolcache/Python/3.14.10/x64/bin:$PATH
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
